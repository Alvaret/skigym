---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Plan de entrenamiento Onil Trails 14K' } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #f4f1ea;
        --bg-deep: #ebe5d8;
        --surface: #fffdfa;
        --surface-alt: #efe9dc;
        --ink: #1d211b;
        --muted: #5e6657;
        --line: #d4ccbc;
        --line-strong: #b8ae9a;
        --accent: #c95d2e;
        --accent-soft: rgba(201,93,46,.12);
        --forest: #2f5a3a;
        --forest-soft: rgba(47,90,58,.12);
        --sky: #1f5f7a;
        --warn: #9a5a00;
        --radius: 18px;
        --shadow: 0 1px 2px rgba(29,33,27,.04), 0 8px 24px rgba(29,33,27,.04);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        color: var(--ink);
        background: var(--bg);
        font-family: 'Work Sans', system-ui, sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: .35;
        background-image:
          repeating-radial-gradient(circle at 20% 30%, transparent 0 28px, rgba(94,102,87,.07) 29px 30px),
          repeating-radial-gradient(circle at 80% 70%, transparent 0 38px, rgba(94,102,87,.05) 39px 40px);
      }
      a { color: inherit; }
      img { max-width: 100%; display: block; }
      code { font-family: ui-monospace, SFMono-Regular, monospace; font-size: .95em; background: rgba(29,33,27,.06); padding: .12em .35em; border-radius: 4px; }
      .wrap { width: min(1120px, calc(100% - 32px)); margin: 0 auto; position: relative; }
      .display { font-family: 'Barlow Condensed', Impact, sans-serif; letter-spacing: -0.01em; line-height: .92; text-transform: uppercase; }
      .pill {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 10px; border-radius: 999px; font-size: 12px; font-weight: 600;
        border: 1px solid var(--line); background: rgba(255,253,250,.7); color: var(--muted);
        white-space: nowrap;
      }
      .pill.phase { color: var(--forest); background: var(--forest-soft); border-color: rgba(47,90,58,.18); }
      .pill.rpe { color: var(--warn); background: rgba(154,90,0,.1); border-color: rgba(154,90,0,.18); }
      .pill.accent { color: var(--accent); background: var(--accent-soft); border-color: rgba(201,93,46,.18); }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        min-height: 44px; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--line-strong);
        background: var(--surface); color: var(--ink); text-decoration: none; font-weight: 600; font-size: 14px;
      }
      .btn:hover { border-color: var(--ink); }
      @media (max-width: 720px) {
        .wrap { width: min(100% - 24px, 1120px); }
      }
      @media print {
        body::before { display: none; }
        body { background: #fff; }
        .no-print { display: none !important; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
