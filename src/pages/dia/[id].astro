---
import Base from '../../layouts/Base.astro';
import plan from '../../data/plan.json';

export function getStaticPaths() {
  return plan.dias.map((d) => ({ params: { id: d.id }, props: { dia: d, dias: plan.dias } }));
}

const { dia, dias } = Astro.props;
const idx = dias.findIndex((d) => d.id === dia.id);
const prev = idx > 0 ? dias[idx - 1] : null;
const next = idx < dias.length - 1 ? dias[idx + 1] : null;
const fuerza = dia.fuerza;
const hasBlocks = fuerza.bloques && fuerza.bloques.length > 0;

function kindLabel(tipo) {
  if (tipo.includes('esqui')) return 'Esquí';
  if (tipo.includes('run-walk')) return 'Run-walk';
  if (tipo.includes('cuestas')) return 'Cuestas';
  if (tipo.includes('intervalos')) return 'Intervalos';
  if (tipo.includes('rodaje')) return 'Rodaje';
  if (tipo.includes('recuperacion')) return 'Recuperación';
  if (tipo.includes('control')) return 'Control';
  if (tipo.includes('ninguno')) return 'Descanso';
  if (tipo.includes('gym-pierna')) return 'Gym pierna';
  if (tipo.includes('casa-pierna')) return 'Casa pierna';
  if (tipo.includes('micro-pierna')) return 'Micro pierna';
  if (tipo.includes('descanso')) return 'Descanso';
  return 'Sesión';
}
---
<Base title={`${dia.fecha} · ${dia.diaSemana} — Plan Onil Trails 14K`} description={`${dia.fecha} ${dia.diaSemana}: ${dia.cardio.titulo} / ${dia.fuerza.titulo}`}>
  <div class="wrap">
    <nav class="topbar no-print">
      <a class="btn" href="/">← Calendario</a>
      <div class="topbar-nav">
        {prev ? <a class="btn icon-btn" href={`/dia/${prev.id}/`} aria-label={`Día anterior: ${prev.fecha}`}>←</a> : <span class="btn icon-btn disabled" aria-hidden="true">←</span>}
        {next ? <a class="btn icon-btn" href={`/dia/${next.id}/`} aria-label={`Día siguiente: ${next.fecha}`}>→</a> : <span class="btn icon-btn disabled" aria-hidden="true">→</span>}
      </div>
    </nav>

    <header class="hero">
      <div class="eyebrow">{dia.semana}</div>
      <h1 class="display">{dia.fecha}</h1>
      <p class="dow">{dia.diaSemana}</p>
      <div class="pills">
        <span class="pill phase">{dia.fase}</span>
        <span class="pill rpe">{dia.rpeFc}</span>
        <span class="pill accent">{kindLabel(dia.cardio.tipo)}</span>
      </div>
    </header>

    <main class="stack">
      <section class="panel">
        <div class="panel-head">
          <span class="panel-kicker">Diario</span>
          <h2 class="display">Andar</h2>
        </div>
        <p class="panel-title">{dia.andar.titulo}</p>
        <p class="panel-body">{dia.andar.detalle}</p>
      </section>

      <section class="panel">
        <div class="panel-head">
          <span class="panel-kicker">Sesión</span>
          <h2 class="display">Cardio</h2>
        </div>
        <p class="panel-title">{dia.cardio.titulo}</p>
        <p class="panel-body">{dia.cardio.detalle}</p>
      </section>

      <section class="panel">
        <div class="panel-head">
          <span class="panel-kicker">Trabajo</span>
          <h2 class="display">Fuerza</h2>
        </div>
        <p class="panel-title">{fuerza.titulo}</p>
        {fuerza.calentamiento && (
          <div class="meta-block">
            <span class="meta-k">Calentamiento</span>
            <p>{fuerza.calentamiento}</p>
          </div>
        )}

        {hasBlocks ? (
          <div class="blocks">
            {fuerza.bloques.map((b, i) => (
              <article class="exercise">
                <div class="exercise-head">
                  <span class="exercise-num">{i + 1}</span>
                  <h3>{b.ejercicio}</h3>
                </div>
                <dl class="fields">
                  <div class="field"><dt>Series</dt><dd>{b.series}</dd></div>
                  <div class="field"><dt>Reps</dt><dd>{b.repeticiones}</dd></div>
                  <div class="field"><dt>Peso</dt><dd>{b.peso}</dd></div>
                  <div class="field"><dt>RPE</dt><dd>{b.rpe}</dd></div>
                  <div class="field"><dt>Descanso</dt><dd>{b.descanso}</dd></div>
                </dl>
                {b.notas && <p class="exercise-note"><strong>Notas:</strong> {b.notas}</p>}
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">No hay bloques de fuerza detallados para este día.</p>
        )}

        {fuerza.vueltaCalma && (
          <div class="meta-block">
            <span class="meta-k">Vuelta a la calma</span>
            <p>{fuerza.vueltaCalma}</p>
          </div>
        )}
        {fuerza.nota && (
          <div class="note-box">
            <span class="meta-k">Nota</span>
            <p>{fuerza.nota}</p>
          </div>
        )}
      </section>

      {dia.notas && (
        <section class="panel">
          <div class="panel-head">
            <span class="panel-kicker">Contexto</span>
            <h2 class="display">Notas del día</h2>
          </div>
          <p class="panel-body">{dia.notas}</p>
        </section>
      )}
    </main>

    <nav class="bottom-nav no-print" aria-label="Navegación entre días">
      {prev ? (
        <a class="nav-card" href={`/dia/${prev.id}/`}>
          <span class="nav-dir">← Anterior</span>
          <span class="nav-date display">{prev.fecha}</span>
          <span class="nav-dow">{prev.diaSemana}</span>
        </a>
      ) : <div />}
      {next ? (
        <a class="nav-card next" href={`/dia/${next.id}/`}>
          <span class="nav-dir">Siguiente →</span>
          <span class="nav-date display">{next.fecha}</span>
          <span class="nav-dow">{next.diaSemana}</span>
        </a>
      ) : <div />}
    </nav>
  </div>
</Base>

<style>
  .topbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 20px 0 0; }
  .topbar-nav { display: flex; gap: 8px; }
  .icon-btn { width: 44px; padding: 0; font-size: 18px; }
  .icon-btn.disabled { opacity: .35; pointer-events: none; }
  .hero { padding: 28px 0 24px; border-bottom: 1px solid var(--line); }
  .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .hero h1 { margin: 0; font-size: clamp(56px, 15vw, 104px); line-height: .88; }
  .dow { margin: 8px 0 0; font-size: 20px; font-weight: 500; color: var(--muted); }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .stack { display: grid; gap: 16px; padding: 24px 0; }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); }
  .panel-head { margin-bottom: 14px; }
  .panel-kicker { display: block; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
  .panel-head h2 { margin: 0; font-size: clamp(34px, 8vw, 52px); line-height: .92; }
  .panel-title { margin: 0 0 10px; font-size: 18px; font-weight: 700; line-height: 1.3; }
  .panel-body { margin: 0; color: #30362c; font-size: 15px; white-space: pre-line; }
  .meta-block { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); }
  .meta-k { display: block; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  .meta-block p, .note-box p { margin: 0; font-size: 14px; color: #30362c; }
  .blocks { display: grid; gap: 12px; margin-top: 18px; }
  .exercise { background: var(--bg); border: 1px solid var(--line); border-radius: 14px; padding: 16px; }
  .exercise-head { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 14px; }
  .exercise-num { flex: 0 0 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: 13px; font-weight: 700; }
  .exercise h3 { margin: 0; font-size: 17px; line-height: 1.3; }
  .fields { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin: 0; }
  .field { background: var(--surface); border: 1px solid rgba(212,204,188,.8); border-radius: 10px; padding: 10px; min-width: 0; }
  .field dt { font-size: 10px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); margin: 0; }
  .field dd { margin: 4px 0 0; font-size: 14px; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
  .exercise-note { margin: 12px 0 0; font-size: 13px; color: var(--muted); }
  .empty { margin: 12px 0 0; color: var(--muted); font-size: 14px; }
  .note-box { margin-top: 16px; padding: 14px; border-radius: 12px; background: var(--accent-soft); border: 1px solid rgba(201,93,46,.15); }
  .note-box p { color: #4a2a1d; }
  .bottom-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 8px 0 48px; }
  .nav-card { display: flex; flex-direction: column; gap: 2px; padding: 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; text-decoration: none; box-shadow: var(--shadow); }
  .nav-card:hover { border-color: var(--line-strong); }
  .nav-card.next { text-align: right; }
  .nav-dir { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
  .nav-date { font-size: 32px; line-height: .95; margin-top: 6px; }
  .nav-dow { font-size: 13px; color: var(--muted); }
  @media (max-width: 720px) {
    .panel { padding: 16px; }
    .fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field:last-child { grid-column: span 2; }
    .bottom-nav { grid-template-columns: 1fr; }
    .nav-card.next { text-align: left; }
  }
  @media print {
    .panel, .nav-card, .exercise, .field { box-shadow: none; }
    .bottom-nav { display: none; }
  }
</style>
